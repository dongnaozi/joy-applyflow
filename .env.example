# Copy this file to .env beside server.py. Process environment variables win.
# Python 3.10+; literal KEY=value only, with optional quotes and # comments.
APP_PORT=8792
APP_BIND=127.0.0.1
# Blank uses the platform's private state directory, outside this project.
# Windows: %APPDATA%/joy-applyflow/private
# macOS: ~/Library/Application Support/joy-applyflow/private
# Linux: $XDG_STATE_HOME/joy-applyflow/private or ~/.local/state/joy-applyflow/private
# An explicit path must be outside this project. No variable interpolation.
APP_PRIVATE_DIR=
OLLAMA_DEFAULT_MODEL=deepseek-r1:1.5b
# Only localhost or 127.0.0.1 on HTTP port 11434 and path /v1 are allowed.
OLLAMA_BASE_URL=http://localhost:11434/v1
